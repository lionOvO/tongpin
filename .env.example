APP_ENV=demo
DATA_DIR=./data
AUTO_SEED=false
LLM_MODE=demo
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_DEFAULT_MODEL_ID=deepseek
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_PRO_INPUT_PRICE_PER_MILLION=0
DEEPSEEK_PRO_OUTPUT_PRICE_PER_MILLION=0
# 中转 GPT 使用 Responses；密钥仅放服务器，不得复用 DeepSeek 官方密钥。
RELAY_API_KEY=
RELAY_BASE_URL=https://api.sourcesdata.com/v1
RELAY_MODEL=gpt-5.6-sol
RELAY_SOL_MODEL=gpt-6.1-sol
RELAY_JSON_MODE=true
RELAY_RESPONSES_STREAM=true
RELAY_INPUT_PRICE_PER_MILLION=0
RELAY_OUTPUT_PRICE_PER_MILLION=0
# 其他兼容模型：服务器维护的 JSON 列表，见 docs/模型选择与切换.md。
LLM_PROFILES_JSON=[]
COST_BUDGET_CNY=50
INPUT_PRICE_PER_MILLION=2
OUTPUT_PRICE_PER_MILLION=3
VECTOR_ENABLED=false
API_BASE_URL=http://127.0.0.1:8000

# 阿里云号码认证 PNVS；与 AI 漫剧相同的环境变量名。
# 只在服务器配置，勿放进 VITE_*，勿提交真实密钥。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_SMS_SIGN_NAME=
ALIBABA_SMS_TEMPLATE_CODE=
# 留空沿用阿里云默认方案；有独立方案时填名称，发送与核验必须相同。
ALIBABA_SMS_SCHEME_NAME=
ALIBABA_SMS_REGION=cn-hangzhou
