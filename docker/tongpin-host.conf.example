# Host Nginx: replace SERVER_IP with the actual address.
# WEB_PORT in the server .env must be 18083, bound to 127.0.0.1.
server {
    listen 18082;
    server_name SERVER_IP;
    server_tokens off;
    client_max_body_size 55m;
    access_log /var/log/nginx/tongpin-access.log;
    error_log /var/log/nginx/tongpin-error.log;
    location / {
        proxy_pass http://127.0.0.1:18083;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace client-supplied chains at the public edge.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 4200s;
        proxy_send_timeout 4200s;
        proxy_buffering off;
        proxy_cache off;
    }
}
