# Copy to .env on the server. Never commit actual credentials.
APP_ENV=prod
# Defaults to true in prod. Set false only for an explicitly chosen HTTP deployment.
SESSION_COOKIE_SECURE=true
AUTO_SEED=false
LLM_MODE=live
LLM_DEFAULT_MODEL_ID=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
LLM_PROFILES_JSON=[]
RELAY_API_KEY=
COST_BUDGET_CNY=50
INPUT_PRICE_PER_MILLION=2
OUTPUT_PRICE_PER_MILLION=3
VECTOR_ENABLED=false
# Keep loopback when an existing host HTTPS proxy forwards to this port.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=18082
API_CPUS=1.0
API_MEMORY=1g
WEB_CPUS=0.5
WEB_MEMORY=192m
# Optional build mirrors for mainland cloud hosts.
PIP_INDEX_URL=https://pypi.org/simple
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_SMS_SIGN_NAME=
ALIBABA_SMS_TEMPLATE_CODE=
ALIBABA_SMS_SCHEME_NAME=
ALIBABA_SMS_REGION=cn-hangzhou
